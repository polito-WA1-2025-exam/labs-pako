// Funzione per mostrare tutti i dati recuperati
function showAllData() {
    // Recupera e mostra tutti i dati dalle tabelle
    Promise.all([
        getAllBags(),
        getAllEstablishments(),
        getAllPantryItems(),
        getAllShoppingCarts(),
        getAllReservations()
    ])
    .then(([bags, establishments, pantry, carts, reservations]) => {
        console.log('All Bags:', bags);
        console.log('All Establishments:', establishments);
        console.log('All Pantry Items:', pantry);
        console.log('All Shopping Carts:', carts);
        console.log('All Reservations:', reservations);
    })
    .catch(error => {
        console.error('Error fetching data:', error);
    });
}

// Chiama la funzione per visualizzare i dati
showAllData();

Bags.getAvailableBags = function() {
    const availableBags = this.Borse.filter(bag => bag.State === 'Available');
    return availableBags;
}
Bags.getBagsByType = function(type) {
    const filteredBags = this.Borse.filter(bag => bag.Type === type);
    return filteredBags;
}
Bags.getBagsByEstablishment = function(establishmentId) {
    const filteredBags = this.Borse.filter(bag => bag.Establishment_ID === establishmentId);
    return filteredBags;
}

pantry.getFoodsByMinQuantity = function(minQuantity) {
    const filteredFoods = this.TotalFood.filter(food => food.Quantity >= minQuantity);
    return filteredFoods;
}

// Aggiungi un metodo per ottenere un Food specifico per nome
pantry.getFoodByName = function(name) {
    const food = this.TotalFood.find(food => food.Food_Name === name);
    return food;
}
Website.getEstablishmentsByFoodCategory = function(category) {
    const filteredEstablishments = this.List.filter(establishment => establishment.Food_Category === category);
    return filteredEstablishments;
}

// Aggiungi un metodo per ottenere tutti gli Establishments di un tipo specifico (Store o Restaurant)
Website.getEstablishmentsByType = function(type) {
    const filteredEstablishments = this.List.filter(establishment => establishment.Type_Of_Est === type);
    return filteredEstablishments;
}

Reservations.getActiveReservations = function() {
    return this.Prenotazioni.filter(reservation => reservation.Status === 'Active');
}

// Aggiungi un metodo per ottenere tutte le Reservations di un utente specifico
Reservations.getReservationsByUser = function(userId) {
    return this.Prenotazioni.filter(reservation => reservation.User_ID === userId);
}

// Aggiungi un metodo per ottenere tutte le Reservations in un determinato intervallo di tempo
Reservations.getReservationsByTimeRange = function(startTime, endTime) {
    return this.Prenotazioni.filter(reservation => {
        const timestamp = dayjs(reservation.Timestamp);
        return timestamp.isBetween(dayjs(startTime), dayjs(endTime), null, '[]');
    });
}

Cart.getCartsByUser = function(userId) {
    return this.Carrello.filter(cart => cart.User_ID === userId);
}

// Aggiungi un metodo per ottenere tutti i Carrelli con un certo tipo di richiesta
Cart.getCartsByRequest = function(request) {
    return this.Carrello.filter(cart => cart.Requests.includes(request));
}

