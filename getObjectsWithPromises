const sqlite3 = require('sqlite3').verbose(); // Per interagire con il database
const db = new sqlite3.Database('database.db'); // Assumiamo che il database sia 'database.db'
const {Bags,Cart,Reservations,pantry,Website} = require('./lab1.js');
function getAllBags() {
    return new Promise((resolve, reject) => {
        const query = 'SELECT * FROM Bags'; // Query per ottenere tutte le righe dalla tabella Bags
        db.all(query, [], (err, rows) => {
            if (err) {
                reject(err);
            } else {
                resolve(rows);
            }
        });
    });
}

